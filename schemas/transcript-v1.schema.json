{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Granola transcript document version 1",
  "description": "Transcript interchange, not a full-library backup. Runtime validation also enforces UTF-8 byte limits, valid calendar dates, end >= start, at most 255 speaker labels per note, and a 20 MiB serialized document limit. No schema URL is fetched by the CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "notes"],
  "properties": {
    "format": { "const": "open-granola.transcript" },
    "version": { "const": 1 },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "created_at", "transcript"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "created_at": { "type": "string", "format": "date-time" },
          "summary": { "type": "string", "maxLength": 1000000 },
          "transcript": {
            "type": "array",
            "maxItems": 50000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "text"],
              "properties": {
                "start": { "type": "number", "minimum": 0, "maximum": 604800 },
                "end": { "type": "number", "minimum": 0, "maximum": 604800 },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                }
              }
            }
          }
        }
      }
    }
  }
}
