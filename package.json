{
  "name": "open-granola",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "test": "vitest run && node --test scripts/check-security.test.mjs",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run check:security && npm run build",
